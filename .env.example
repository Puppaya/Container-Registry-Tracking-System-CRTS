# SQL Server Connection (CRTS)
DB_SERVER=your-sql-server-ip
DB_PORT=1433
DB_DATABASE=db_crts
DB_USER=your-db-user
DB_PASSWORD=your-password

DATABASE_URL="sqlserver://your-sql-server-ip:1433;database=db_crts;user=your-db-user;password=your-password;trustServerCertificate=true;encrypt=false"

# Session Secret (must be at least 32 characters, generate a random string)
NUXT_SESSION_PASSWORD=your-random-secret-at-least-32-chars

# AES Encryption Secret Key (used for encrypting passwords in transit)
# Must be the same value used in app/utils/crypto.ts and server/utils/crypto.ts
SECRET_KEY=your-random-secret-key

# External Survey System — Pull only (Phase 1)
# CRTS calls GET on Survey API when user clicks Sync or scheduler runs.
# Example local HTTPS: https://localhost:7292/api/survey/records
SURVEY_API_URL=
SURVEY_API_KEY=
# Set true for local self-signed HTTPS (localhost dev only)
SURVEY_API_TLS_INSECURE=false
SURVEY_SYNC_ENABLED=true

# Inbound integrations — Smart Gate push (Gate In/Out when container number is present)
CRTS_INTEGRATION_API_KEY=your-integration-api-key

# External Container Management / Yard System (optional — manual movement entry when empty)
YARD_API_URL=
YARD_API_KEY=
YARD_SYNC_ENABLED=true

# External Smart Gate System — Push only (Smart Gate POSTs gate events to CRTS)
# Pull vars below are optional / unused when using push-only integration
SMART_GATE_API_URL=
SMART_GATE_API_KEY=
SMART_GATE_SYNC_ENABLED=true

# File Storage — MinIO (S3-compatible; uses local .data/storage when S3_* is empty)
# Example MinIO:
#   S3_ENDPOINT=http://10.0.200.105:9000
#   S3_ACCESS_KEY=admin
#   S3_SECRET_KEY="your-secret"   # quote if password contains #
#   S3_BUCKET=crts
#   S3_BUCKET=crts
#   MINIO_RETURN_PATH=https://your-file-proxy.example.com:4430
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=crts-documents
S3_REGION=us-east-1
MINIO_RETURN_PATH=
STORAGE_LOCAL_PATH=
