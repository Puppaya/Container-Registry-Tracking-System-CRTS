generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id       Int     @id @default(autoincrement())
  username String? @unique
  email    String  @unique
  password String
  name     String?
  avatar   String?
  role     String  @default("USER")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  avatar    String?
  status    String   @default("subscribed")
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}